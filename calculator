<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reactor Calculator | PBCC Tools</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #0f0f1b; color: #fff; padding: 40px; display: flex; flex-direction: column; align-items: center; }
        .card { background: rgba(255,255,255,0.05); padding: 30px; border-radius: 16px; width: 100%; max-width: 600px; text-align: center; }
        
        /* Progress Bar */
        .progress-container { width: 100%; height: 30px; background: #222; border-radius: 15px; margin: 20px 0; overflow: hidden; border: 1px solid #444; }
        #temp-bar { width: 0%; height: 100%; background: linear-gradient(90deg, #3498db, #e74c3c); transition: width 0.5s ease; }
        
        /* Controls */
        .controls { display: grid; gap: 20px; margin-top: 30px; }
        .control-group { display: flex; flex-direction: column; gap: 10px; }
        .btn-group { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        button { padding: 10px 15px; border-radius: 8px; border: none; background: #333; color: white; cursor: pointer; transition: 0.2s; }
        button.active { background: #e67e22; }
        button:hover { background: #444; }
    </style>
</head>
<body>

    <div class="card">
        <h1>Reactor Monitor</h1>
        <div class="progress-container"><div id="temp-bar"></div></div>
        <h2 id="temp-display">0°C / 4000°C</h2>

        <div class="controls">
            <div class="control-group">
                <label>Reactor Power</label>
                <div class="btn-group" id="power-btns">
                    <button onclick="update('power', 1)">1</button>
                    <button onclick="update('power', 2)">2</button>
                    <button onclick="update('power', 3)">3</button>
                    <button onclick="update('power', 4)">4</button>
                </div>
            </div>
            <div class="control-group">
                <label>Coolant</label>
                <div class="btn-group">
                    <button onclick="update('coolant', true)">ON</button>
                    <button onclick="update('coolant', false)">OFF</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let state = { power: 1, coolant: false };
        let temp = 0;

        function update(key, val) {
            state[key] = val;
            // Add visual active class logic here later
            calculate();
        }

        function calculate() {
            // Simplified logic: adjust temp based on state
            temp += (state.power * 10) - (state.coolant ? 20 : 0);
            if(temp < 0) temp = 0;
            if(temp > 4000) temp = 4000;
            
            document.getElementById('temp-bar').style.width = (temp/4000 * 100) + '%';
            document.getElementById('temp-display').innerText = Math.floor(temp) + '°C / 4000°C';
        }
    </script>
</body>
</html>
